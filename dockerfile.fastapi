# ============================================================
# VerbaPost — FastAPI container (new backend)
# The old `dockerfile` (Streamlit) remains untouched until cutover.
# Build:  docker build -f dockerfile.fastapi -t verbapost-web .
# ============================================================
FROM python:3.12-slim

WORKDIR /app

# Dependencies first (layer caching: rebuilds are fast when only code changes)
COPY requirements-fastapi.txt .
RUN pip install --no-cache-dir -r requirements-fastapi.txt

# App code (engines at root + app/ package)
COPY . .

# Cloud Run injects PORT (default 8080)
ENV PORT=8080
EXPOSE 8080

CMD exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 2
