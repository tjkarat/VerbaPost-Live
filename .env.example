# ============================================================
# Local development env vars for the FastAPI app.
# Copy to `.env`, fill in STAGING/TEST values (never live keys),
# then:  set -a; source .env; set +a; uvicorn app.main:app --reload
# `.env` is already gitignored — never commit real values.
# ============================================================

ENV=development
SESSION_SECRET=generate-a-long-random-string

BASE_URL=http://localhost:8000

# Supabase (use the STAGING project)
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# Stripe (TEST mode keys: sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# PostGrid (TEST key)
POSTGRID_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Twilio (test credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Resend / email
RESEND_API_KEY=
EMAIL_SENDER=

# Geocodio
GEOCODIO_API_KEY=

# PostcardMania (parked until post-migration)
PCM_API_KEY=
PCM_BASE_URL=
PCM_API_SECRET=

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Analytics
GA_ID=
